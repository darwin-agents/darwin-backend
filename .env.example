# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Darwin Backend"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development  # development | staging | production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AGENT_TOKEN_EXPIRE_MINUTES=15

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ── Modal ─────────────────────────────────────────────────────────────────────
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
MODAL_APP_NAME=darwin-agent
MODAL_CONTAINER_TIMEOUT_SECONDS=900

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=optional_secret_for_telegram_webhook_verification

# ── Encryption (VCC) ──────────────────────────────────────────────────────────
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
VCC_ENCRYPTION_KEY=base64_encoded_32_byte_aes256_key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Telemetry circuit-breaker thresholds ──────────────────────────────────────
METABOLIC_RUNAWAY_MULTIPLIER=60.0
CREDENTIAL_STUFFING_THRESHOLD=50
DDOS_REQUESTS_PER_MINUTE=1000
