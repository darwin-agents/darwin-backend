# ─────────────────────────────────────────────────────────────────────────────
# Darwin Backend — Phase 1 Environment Variables
# Copy this file to .env and fill in all values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
ENVIRONMENT=development         # development | staging | production

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# HS256 (symmetric) access tokens only. Asymmetric (ES256/RS256) tokens use JWKS from SUPABASE_URL.
SUPABASE_JWT_SECRET=supabase-jwt-secret

# ── PostgreSQL (asyncpg direct connection for FOR UPDATE locks) ───────────────
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-id>.supabase.co:5432/postgres

# ── Agent JWT (separate secret from Supabase — never expose) ─────────────────
# Generate with: openssl rand -hex 64
AGENT_JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── VCC Encryption (pgcrypto symmetric key) ───────────────────────────────────
# Used by pgp_sym_encrypt/decrypt for PAN/CVV storage
VCC_ENCRYPTION_KEY=your-strong-passphrase-for-pgcrypto-aes256

# ── Modal ─────────────────────────────────────────────────────────────────────
MODAL_TOKEN_ID=ak-xxxxxxxxxx
MODAL_TOKEN_SECRET=as-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODAL_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx    # HMAC secret for Modal webhook verification
MODAL_APP_NAME=darwin-agent
MODAL_FUNCTION_NAME=run_agent
MODAL_ENVIRONMENT_NAME=main                    # optional; set your deployed Modal env name

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ADMIN_CHAT_ID=123456789    # Platform-level admin alerts channel

# ── Stripe (Phase 1: webhook verification only) ───────────────────────────────
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Langfuse (Mental Replay — same project as Hermes observability/langfuse) ──
# Session id in Langfuse is `darwin_id::session_id` (see darwin-agent config.yaml.j2).
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Browserbase (stealth browser sessions) ────────────────────────────────────
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0        # or Upstash: rediss://...

# ── OpenRouter (single LLM/embeddings gateway for backend + mirrored agent usage)
OPENROUTER_API_KEY_1=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_2=                          # optional second key for multiplexing

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://app.darwin.ai   # recommended by OpenRouter
OPENROUTER_APP_TITLE=Darwin

# Routed models (must be OpenRouter slugs — see https://openrouter.ai/models ).
OPENROUTER_INTENT_SCAN_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional spend guardrails — see README.
GATEWAY_MIN_LEDGER_BALANCE=0                     # inference blocked at or below balance (decimal USD)
SESSION_LLM_SPEND_CAP_USD=0                      # telemetry session cap via Redis — 0 = disabled

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]
